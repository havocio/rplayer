{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rplayer",
  "version": "0.1.0",
  "identifier": "app.rplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rplayer",
        "width": 1080,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "Music",
    "publisher": "rplayer",
    "copyright": "© 2026 rplayer contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
