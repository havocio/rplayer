{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rplayer",
  "version": "0.1.0",
  "identifier": "app.rplayer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rplayer",
        "width": 1080,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0f1320"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Music",
    "publisher": "rplayer",
    "copyright": "© 2026 rplayer contributors",
    "shortDescription": "轻量无损音乐播放器",
    "longDescription": "Rust + Tauri 打造的轻量无损音乐播放器，支持 FLAC / WAV / APE 等格式。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
